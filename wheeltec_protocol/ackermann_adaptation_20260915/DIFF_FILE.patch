+[Unit]
+Description=RK3588 Wheeltec Ackermann telemetry and guarded control
+After=network.target
+
+[Service]
+Type=simple
+User=root
+WorkingDirectory=/root/wheeltec
+LogsDirectory=rk3588-wheeltec
+ExecStart=/root/wheeltec/run_driver.sh
+Restart=on-failure
+RestartSec=2
+KillSignal=SIGINT
+TimeoutStopSec=8
+Environment=PYTHONUNBUFFERED=1
+Environment=ROS_LOG_DIR=/var/log/rk3588-wheeltec
+Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
+
+[Install]
+WantedBy=multi-user.target
