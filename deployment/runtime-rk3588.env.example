# 正点原子 RK3588（Ubuntu 24.04、ROS 2 Jazzy）+ Gen5 差速车：复制到 /etc/rk3588/runtime.env。
# 值是数据，不是 shell 命令：不要 export、$ 展开或命令替换。进程环境变量优先于本文件。
ROS_DISTRO=jazzy
# 相对路径按当前发布目录（/opt/rk3588/current）算，换发布后自动跟着走。
# drive.type = differential：chassis 起欧艾迪驱动（oid_protocol），imu 起 HDA536T 驱动（rion_protocol）
RK3588_ROBOT_CONFIG=robot_core/robot_gen5.json
# 系统自带 python3（Jazzy 的 rclpy 装在它下面），不用写：
# RK3588_PYTHON=/usr/bin/python3

# 手动水泵：板载蓝牙 → HC-08 → 单片机右下；压力 1–100 对应右下最大输出百分比。
RK3588_PUMP_ENABLED=0
RK3588_PUMP_BACKEND=hc08
RK3588_HC08_ADDRESS=F8:2E:0C:E3:A0:A8
RK3588_HC08_ADAPTER=hci0
# 选择 RK3588_PUMP_BACKEND=gpio 才使用原 GPIO0_C6 输出及下列 PWM 频率。
RK3588_PUMP_PWM_HZ=50
