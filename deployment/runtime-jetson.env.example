# Copy relevant assignments to /etc/rk3588/runtime.env (or select another file
# with ROBOT_RUNTIME_ENV in the launching process). Process environment wins.
# Values are data, not shell commands: no export, $ expansion or substitution.
# Use absolute paths for board-specific files; do not copy these placeholders.
# ROS_DISTRO=humble
# RK3588_PYTHON=/opt/rk3588/venv/bin/python3
# RK3588_ROBOT_CONFIG=/etc/rk3588/robot.json
# RK3588_DEPTH_PATH_CONFIG=/etc/rk3588/depth_path.json
# RK3588_POSE_MODEL=/opt/rk3588/current/radar_system/models/yolo26s.pt
# Optional board-local TensorRT export: /opt/rk3588/current/radar_system/models/yolo26s.engine
# RK3588_CAMERA_WORKSPACE=/home/wheeltec/install/setup.bash
ROBOT_FOLLOW_CONTROLLER=mppi
ROBOT_MPPI_DEVICE=cuda
ROBOT_MPPI_SAMPLES=1024
# To select the CPU geometric controller explicitly:
# ROBOT_FOLLOW_CONTROLLER=pure-pursuit
