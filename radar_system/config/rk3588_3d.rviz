Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Camera RGB Cloud1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 557
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Value: true
      Reference Frame: base_link
      Plane Cell Count: 20
      Cell Size: 1.0
      Color: 100; 120; 140
    - Class: rviz_default_plugins/TF
      Name: TF
      Value: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
      Color: 0; 242; 254
      Color Transformer: FlatColor
      Size (Pixels): 4
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera RGB Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/depth_registered/points
      Value: true
      Color Transformer: RGB8
      Size (Pixels): 3
      Style: Points
      Decay Time: 0
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
      Alpha: 0.5
  Global Options:
    Background Color: 15; 22; 32
    Fixed Frame: base_link
    Frame Rate: 30
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.2
      Name: Current View
      Pitch: 0.45
      Yaw: 3.14159
      Target Frame: base_link
