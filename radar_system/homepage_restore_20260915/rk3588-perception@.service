[Unit]
Description=RK3588 perception component %i
After=network.target display-manager.service
PartOf=rk3588-perception.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/radar_system
ExecStart=/root/radar_system/start_component.sh %i
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=8
LogsDirectory=rk3588-perception/%i
Environment=ROS_LOG_DIR=/var/log/rk3588-perception/%i
Environment=ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
Environment=PYTHONUNBUFFERED=1
