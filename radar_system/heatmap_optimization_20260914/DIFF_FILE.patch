 import cv2
 
 CORS_CONFIG_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "cors_config.json")
+
+DEPTH_VALID_MIN_MM = 200
+DEPTH_VALID_MAX_MM = 5500
+HEAT_BG_RGB = (18, 14, 24)
+
+
+def depth_auto_range(valid_mm, prev_near=None, prev_far=None, alpha=0.18):
+    """Percentile range for display; EMA-smoothed so the legend does not flicker."""
+    near = float(np.percentile(valid_mm, 2))
+    far = float(np.percentile(valid_mm, 98))
+    if far - near < 300:
+        mid = 0.5 * (near + far)
+        near, far = mid - 150.0, mid + 150.0
+    near = max(float(DEPTH_VALID_MIN_MM), near)
+    far = min(float(DEPTH_VALID_MAX_MM), max(far, near + 300.0))
+    if prev_near is None or prev_far is None:
+        return near, far
+    return ((1.0 - alpha) * prev_near + alpha * near,
+            (1.0 - alpha) * prev_far + alpha * far)
+
+
+def _draw_heatmap_legend(rgb, near_mm, far_mm):
+    bar_h = 36
+    h, w = rgb.shape[:2]
+    canvas = np.empty((h + bar_h, w, 3), np.uint8)
+    canvas[:h] = rgb
+    canvas[h:] = HEAT_BG_RGB
+    lut = cv2.applyColorMap(np.arange(255, -1, -1, dtype=np.uint8).reshape(1, 256), cv2.COLORMAP_TURBO)
+    lut = cv2.cvtColor(lut, cv2.COLOR_BGR2RGB)
+    x0 = 12 if w > 40 else 2
+    bar_w = max(8, w - x0 * 2)
+    bar = cv2.resize(lut, (bar_w, 10), interpolation=cv2.INTER_LINEAR)
+    canvas[h + 6:h + 16, x0:x0 + bar_w] = bar
+    cv2.putText(canvas, f'{near_mm / 1000.0:.2f}m', (x0, h + 32),
+                cv2.FONT_HERSHEY_SIMPLEX, 0.42, (205, 216, 230), 1, cv2.LINE_AA)
+    far = f'{far_mm / 1000.0:.2f}m'
+    tx = max(x0, w - 7 * len(far) - 4)
+    cv2.putText(canvas, far, (tx, h + 32),
+                cv2.FONT_HERSHEY_SIMPLEX, 0.42, (205, 216, 230), 1, cv2.LINE_AA)
+    return canvas
+
+
+def render_depth_heatmap(depth_mm, rgb=None, near_mm=None, far_mm=None, scale=1):
+    """Display-only Turbo heatmap. Never mutates depth_mm (measurement stays on source).
+
+    Astra S leaves large IR holes; painting those black fragments the picture into
+    mosaic tiles. Valid pixels get a percentile-stretched colormap, small holes are
+    filled for display, and remaining gaps keep a dim RGB underlay so the scene stays whole.
+    """
+    depth = np.asarray(depth_mm)
+    h, w = depth.shape[:2]
+    valid = (depth > DEPTH_VALID_MIN_MM) & (depth <= DEPTH_VALID_MAX_MM)
+    if near_mm is None or far_mm is None:
+        if np.any(valid):
+            near_mm, far_mm = depth_auto_range(depth[valid])
+        else:
+            near_mm, far_mm = 350.0, 4500.0
+    span = max(300.0, float(far_mm) - float(near_mm))
+    far_mm = float(near_mm) + span
+
+    unit = np.zeros((h, w), np.float32)
+    if np.any(valid):
+        unit[valid] = np.clip((far_mm - depth[valid].astype(np.float32)) / span, 0.0, 1.0)
+    u8 = np.clip(unit * 255.0, 0, 255).astype(np.uint8)
+    mask = valid.astype(np.uint8) * 255
+    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))
+    closed = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, kernel)
+    holes = (closed > 0) & (~valid)
+    if np.any(holes):
+        u8 = np.where(holes, cv2.dilate(u8, kernel), u8).astype(np.uint8)
+    if np.any(closed):
+        u8 = cv2.bilateralFilter(u8, d=5, sigmaColor=22, sigmaSpace=5)
+
+    out_w, out_h = int(w * scale), int(h * scale)
+    interp = cv2.INTER_CUBIC if scale > 1 else cv2.INTER_LINEAR
+    u8_up = u8 if scale == 1 else cv2.resize(u8, (out_w, out_h), interpolation=interp)
+    alpha = closed if scale == 1 else cv2.resize(closed, (out_w, out_h), interpolation=cv2.INTER_LINEAR)
+    alpha = np.clip((alpha.astype(np.float32) / 255.0 - 0.12) / 0.55, 0.0, 1.0)
+    alpha = cv2.GaussianBlur(alpha, (0, 0), 0.8)
+
+    heat = cv2.cvtColor(cv2.applyColorMap(u8_up, cv2.COLORMAP_TURBO), cv2.COLOR_BGR2RGB).astype(np.float32)
+    bg = np.empty_like(heat)
+    bg[:] = HEAT_BG_RGB
+    if rgb is not None:
+        rgb_arr = np.asarray(rgb)
+        if rgb_arr.ndim == 3 and rgb_arr.shape[0] == h and rgb_arr.shape[1] == w:
+            rgb_up = cv2.resize(rgb_arr, (out_w, out_h), interpolation=cv2.INTER_LINEAR).astype(np.float32)
+            heat = heat * 0.72 + rgb_up * 0.28
+            bg = rgb_up * 0.22
+    out = heat * alpha[..., None] + bg * (1.0 - alpha[..., None])
+    out = np.ascontiguousarray(np.clip(out, 0, 255).astype(np.uint8))
+    out = _draw_heatmap_legend(out, near_mm, far_mm)
+    return out, float(near_mm), float(far_mm)
 
